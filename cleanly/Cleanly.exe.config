<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework settings for Cleanly.exe (pywebview loads WebView2
  through pythonnet). Lets the bundled assemblies load even when
  Windows marked them as downloaded from the internet.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
